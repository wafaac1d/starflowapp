{
  "name": "starflow-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "texts": "node scripts/compile-texts.mjs",
    "texts:check": "node scripts/compile-texts.mjs --check",
    "copy-logo": "node scripts/copy-logo.mjs",
    "icons": "node --experimental-strip-types scripts/gen-icon-names.ts",
    "predev": "node --experimental-strip-types scripts/gen-icon-names.ts",
    "prebuild": "node --experimental-strip-types scripts/gen-icon-names.ts",
    "dev": "node scripts/compile-texts.mjs && node scripts/copy-logo.mjs && vite",
    "build": "node scripts/compile-texts.mjs && node scripts/copy-logo.mjs && tsc --noEmit --pretty false && vite build",
    "typecheck": "node scripts/compile-texts.mjs && node scripts/copy-logo.mjs && tsc --noEmit --pretty false",
    "lint": "tsc --noEmit --pretty false",
    "test": "node scripts/compile-texts.mjs && node scripts/copy-logo.mjs && vitest run",
    "e2e": "playwright test",
    "test:e2e": "playwright test",
    "openapi:check": "openapi-typescript openapi.json --output /tmp/starflow-schema.d.ts && diff -u src/api/schema.d.ts /tmp/starflow-schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.16",
    "js-yaml": "^4.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "@playwright/test": "^1.55.0",
    "openapi-typescript": "^7.6.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
