# Скопируйте в .env. Секреты ниже — заглушки для локального файла, не боевые ключи.
# Во frontend и в переменные VITE_* эти значения не передаются.

BOT_TOKEN=0000000000:replace-with-telegram-bot-token
ADMIN_IDS=1
DATABASE_URL=postgresql+asyncpg://starflow:starflow@postgres:5432/starflow
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Только эти два идентификатора. Другое имя DeepSeek отвечает 400, и разбор уходит в запасной текст.
DEEPSEEK_MODEL_FAST=deepseek-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SEC=60
DEEPSEEK_MAX_RETRIES=3
# Цена подписки и подарка в Stars, от 1 до 10000. Файл plans.yaml эту сумму не задаёт.
PREMIUM_PRICE_STARS=250
DEFAULT_TIMEZONE=Europe/Moscow
DEFAULT_LOCALE=ru
MEMORY_CACHE_SIZE=5000
LOG_LEVEL=INFO
WEBHOOK_URL=
WEBHOOK_SECRET=
MINI_APP_URL=
PUBLIC_BASE_URL=http://127.0.0.1:8000
PAYMENT_HMAC_SECRET=replace-with-payment-hmac-secret-32
AUTH_SESSION_SECRET=replace-with-auth-session-secret-32
ALLOWED_ORIGINS=
APP_ENV=local
HOST=0.0.0.0
PORT=8000
WEB_CONCURRENCY=1
SINGLETON_LOCK=true
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=StarFlow/0.1 (local development)
OUTBOX_INTERVAL_SEC=30
AUTH_MAX_AGE_SEC=86400
AUTH_FUTURE_SKEW_SEC=60
SESSION_TTL_SEC=3600
DEV_AUTH_ENABLED=false
BOT_RETRY_SEC=5
